<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#1a1a2e">

    <!-- 标题 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🏝️ 小米超级岛 Demo"
        android:textSize="24sp"
        android:textColor="#ffffff"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Xiaomi HyperOS Super Island"
        android:textSize="12sp"
        android:textColor="#888888"
        android:layout_marginBottom="16dp" />

    <!-- 状态面板 -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#16213e"
        android:padding="12dp"
        android:textSize="11sp"
        android:textColor="#aaaaaa"
        android:fontFamily="monospace"
        android:layout_marginBottom="16dp"
        android:text="加载中..." />

    <!-- 场景按钮 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📋 发送超级岛通知"
        android:textSize="14sp"
        android:textColor="#e94560"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_taxi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🚗 打车场景 — 接驾中"
        android:textAllCaps="false"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_delivery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🛵 外卖配送 — 骑手赶来中"
        android:textAllCaps="false"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_timer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⏱️ 倒计时 — 计时中"
        android:textAllCaps="false"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_cancel_all"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="❌ 清除所有岛通知"
        android:textAllCaps="false"
        android:backgroundTint="#e94560"
        android:layout_marginBottom="16dp" />

    <!-- 桥接功能 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔗 通知桥接"
        android:textSize="14sp"
        android:textColor="#e94560"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_open_listener"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚙️ 开启通知监听权限"
        android:textAllCaps="false"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_test_bridge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🧪 模拟微信通知桥接"
        android:textAllCaps="false"
        android:layout_marginBottom="16dp" />

    <!-- 提示 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="仅支持 Xiaomi HyperOS 设备"
            android:textSize="10sp"
            android:textColor="#555555"
            android:gravity="center" />

    </LinearLayout>

</LinearLayout>
